NODE_ENV=development
PORT=3000
JWT_SECRET=change-me-in-development-only-32-chars
# Short-lived access token. No refresh token yet (Phase 7 hardening).
JWT_EXPIRES_IN=15m
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/emobridge
AI_SERVICE_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
OAUTH_COOKIE_SECRET=change-me-in-development-only-32-char
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
